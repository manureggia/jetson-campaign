+/* Locked and prefaulted, so the measurement loop never page-faults */
+static void *job_alloc(unsigned long size)
+{
+	void *p = mmap(NULL, size, PROT_READ | PROT_WRITE,
+		       MAP_PRIVATE | MAP_ANONYMOUS | MAP_POPULATE, -1, 0);
+
+	if (p == MAP_FAILED)
+		fatal("cyclictest-job: cannot map %lu bytes\n", size);
+	if (mlock(p, size))
+		fatal("cyclictest-job: cannot lock %lu bytes\n", size);
+	memset(p, 0, size);
+	return p;
+}
+
+static void job_init(void)
+{
+	struct job_hist *h[] = { &job.exec, &job.resp };
+	unsigned long i;
+
+	if (!use_nsecs || num_threads != 1)
+		fatal("cyclictest-job: --job-write/--job-algo require -N and -t 1\n");
+	if (job_write && job_h3track)
+		fatal("cyclictest-job: use either --job-write or --job-algo\n");
+	job.on = 1;
+	if (job_h3track) {
+		job.h3.labels = job_alloc(H3_LABELS_MAX * sizeof(*job.h3.labels));
+		job.h3.offset = job_alloc((H3_FRAMES + 1) * sizeof(*job.h3.offset));
+		job.h3.map = job_alloc(H3_SIZE * H3_SIZE * sizeof(*job.h3.map));
+		job.h3.target = job_alloc(2 * H3_MARKERS * sizeof(*job.h3.target));
+		job.h3.prev = job_alloc(2 * H3_MARKERS * sizeof(*job.h3.prev));
+		h3_generate(&job.h3);
+		job.h3_hash = h3_input_hash(&job.h3);
+		/* Two passes against the ground truth before measuring; leaves the tracker reset */
+		job.h3_errors = h3_check(&job.h3, 2);
+		if (job.h3_errors)
+			fatal("cyclictest-job: h3track check failed, %lu errors\n", job.h3_errors);
+	} else {
+		job.slot_size = (job_write + JOB_LINE - 1) / JOB_LINE * JOB_LINE;
+		job.slots = job_ring_mib * 1048576UL / job.slot_size;
+		if (job.slots < 2)
+			fatal("cyclictest-job: --job-ring holds fewer than two slots\n");
+		job.ring_size = job.slots * job.slot_size;
+		job.ring = job_alloc(job.ring_size);
+		memset(job.ring, 0x5a, job.ring_size);
+	}
+
+	for (i = 0; i < 2; i++) {
+		h[i]->num = JOB_HIST_RANGE_NS / job_hist_ns;
+		h[i]->buckets = job_alloc(h[i]->num * sizeof(*h[i]->buckets));
+		h[i]->min = INT64_MAX;
+	}
+	if (job_trace_file[0]) {
+		if (!duration)
+			fatal("cyclictest-job: --job-trace requires -D\n");
+		job.trace_len = 2 * ((unsigned long)duration * 1000000UL / interval + 1024);
+		job.trace = job_alloc(job.trace_len * sizeof(*job.trace));
+	}
 }
 
+static void job_write_hist(FILE *f, const char *name, struct job_hist *h, int last)
+{
+	unsigned long i;
+	int comma = 0;
+
+	fprintf(f, "        \"%s\": {\n          \"histogram\": {", name);
+	for (i = 0; i < h->num; i++) {
+		if (!h->buckets[i])
+			continue;
+		fprintf(f, "%s\n            \"%lu\": %lu", comma ? "," : "", i, h->buckets[i]);
+		comma = 1;
+	}
+	fprintf(f, "%s},\n", comma ? "\n          " : "");
+	fprintf(f, "          \"overflow\": %lu,\n", h->overflow);
+	fprintf(f, "          \"min\": %lld,\n", job.cycles ? (long long)h->min : 0LL);
+	fprintf(f, "          \"max\": %lld,\n", (long long)h->max);
+	fprintf(f, "          \"avg\": %.2f\n", job.cycles ? h->sum / job.cycles : 0.0);
+	fprintf(f, "        }%s\n", last ? "" : ",");
+}
+
+static void job_write_json(FILE *f)
+{
+	fprintf(f, "      \"job\": {\n");
+	fprintf(f, "        \"write\": %lu,\n", job_write);
+	fprintf(f, "        \"algo\": \"%s\",\n", job_h3track ? "h3track" : "write");
+	fprintf(f, "        \"ring_bytes\": %lu,\n", job.ring_size);
+	fprintf(f, "        \"slots\": %lu,\n", job.slots);
+	if (job_h3track) {
+		fprintf(f, "        \"h3\": {\"markers\": %d, \"frames\": %d, \"window\": %d, ",
+			H3_MARKERS, H3_FRAMES, 2 * H3_HALF + 1);
+		fprintf(f, "\"input_hash\": \"%016llx\", \"check_errors\": %lu, ",
+			(unsigned long long)job.h3_hash, job.h3_errors);
+		fprintf(f, "\"matched\": %llu, \"created\": %llu, \"merged\": %llu},\n",
+			(unsigned long long)job.h3.matched, (unsigned long long)job.h3.created,
+			(unsigned long long)job.h3.merged);
+	}
+	fprintf(f, "        \"hist_ns\": %lu,\n", job_hist_ns);
+	fprintf(f, "        \"cycles\": %lu,\n", job.cycles);
+	fprintf(f, "        \"missed\": %lu,\n", job.missed);
+	job_write_hist(f, "exec", &job.exec, 0);
+	job_write_hist(f, "response", &job.resp, 1);
+	fprintf(f, "      }\n");
+}
+
+static void job_write_trace(void)
+{
+	unsigned long n = job.cycles < job.trace_len / 2 ? job.cycles : job.trace_len / 2;
+	FILE *f;
+
+	if (!job.trace)
+		return;
+	f = fopen(job_trace_file, "wb");
+	if (!f || fwrite(job.trace, 2 * sizeof(*job.trace), n, f) != n)
+		warn("cyclictest-job: cannot write %s\n", job_trace_file);
+	if (f)
+		fclose(f);
+}
