+/*
+ * cyclictest-job: a job run after each latency sample, from the H3 Vision
+ * case study (Ishii et al., IROS 2009). Either --job-write: one frame of the
+ * 1000 fps camera written per activation into a slot of a ring much larger
+ * than the caches, so the data is cold; or --job-algo=h3track: the software
+ * part of H3 marker tracking (h3track.h). The latency sample is taken before
+ * the job and is unchanged.
  */
+#include "h3track.h"
+
+#define JOB_LINE		64
+#define JOB_HIST_RANGE_NS	10000000UL
+
+struct job_hist {
+	unsigned long *buckets;
+	unsigned long num;
+	unsigned long overflow;
+	int64_t min;
+	int64_t max;
+	double sum;
+};
+
+static unsigned long job_write;
+static int job_h3track;
+static unsigned long job_ring_mib = 64;
+static unsigned long job_hist_ns = 100;
+static char job_trace_file[MAX_PATH];
+
+static struct {
+	int on;
+	char *ring;			/* --job-write */
+	unsigned long ring_size;
+	unsigned long slot_size;
+	unsigned long slots;
+	unsigned long slot;
+	struct h3 h3;			/* --job-algo=h3track */
+	unsigned long h3_errors;
+	uint64_t h3_hash;
+	struct job_hist exec;
+	struct job_hist resp;
+	unsigned long cycles;
+	unsigned long missed;
+	uint32_t *trace;		/* latency_ns, exec_ns per cycle */
+	unsigned long trace_len;
+	volatile uint64_t sink;
+} job;
+
+static void job_run(void)
+{
+	uint64_t *w;
+	unsigned long i, words;
+
+	if (job_h3track) {
+		h3_track(&job.h3);
+		job.sink = job.h3.sink;
+		return;
+	}
+	w = (uint64_t *)(job.ring + job.slot * job.slot_size);
+	if (++job.slot == job.slots)
+		job.slot = 0;
+	words = job.slot_size / sizeof(*w);
+	for (i = 0; i < words; i++)
+		w[i] = job.cycles + i;
+}
+
+static void job_hist_sample(struct job_hist *h, int64_t ns)
+{
+	unsigned long bucket = ns > 0 ? ns / job_hist_ns : 0;
+
+	if (bucket < h->num)
+		h->buckets[bucket]++;
+	else
+		h->overflow++;
+	if (ns < h->min)
+		h->min = ns;
+	if (ns > h->max)
+		h->max = ns;
+	h->sum += ns;
+}
+
+static void job_record(int64_t latency, int64_t exec, int64_t resp)
+{
+	job_hist_sample(&job.exec, exec);
+	job_hist_sample(&job.resp, resp);
+	if (job.trace && 2 * job.cycles + 1 < job.trace_len) {
+		job.trace[2 * job.cycles] = latency > UINT32_MAX ? UINT32_MAX : latency;
+		job.trace[2 * job.cycles + 1] = exec > UINT32_MAX ? UINT32_MAX : exec;
+	}
+	job.cycles++;
+}
