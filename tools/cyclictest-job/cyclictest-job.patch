+/*
+ * cyclictest-job: a synthetic job run after each latency sample, sized on the
+ * memory footprint of a real control task (WATERS 2019 challenge model).
+ * Each activation reads and writes one slot of a ring much larger than the
+ * caches, so its input is cold, as if written by a producer task.
+ * The latency sample is taken before the job and is unchanged.
  */
+#define JOB_LINE		64
+#define JOB_HIST_RANGE_NS	10000000UL
+
+struct job_hist {
+	unsigned long *buckets;
+	unsigned long num;
+	unsigned long overflow;
+	int64_t min;
+	int64_t max;
+	double sum;
+};
+
+static unsigned long job_read, job_write;
+static unsigned long job_ring_mib = 64;
+static unsigned long job_hist_ns = 100;
+static int job_chase;
+static char job_trace_file[MAX_PATH];
+
+static struct {
+	char *ring;
+	unsigned long ring_size;
+	unsigned long slot_size;	/* 0: job disabled */
+	unsigned long slots;
+	unsigned long slot;
+	unsigned long lines;		/* 64 B lines read per activation */
+	uint64_t start;			/* chase: offset of the first line */
+	struct job_hist exec;
+	struct job_hist resp;
+	unsigned long cycles;
+	unsigned long missed;
+	uint32_t *trace;		/* latency_ns, exec_ns per cycle */
+	unsigned long trace_len;
+	volatile uint64_t sink;
+} job;
+
+static void job_run(void)
+{
+	char *base = job.ring + job.slot * job.slot_size;
+	uint64_t sum = 0, off = job.start, *p, *w;
+	unsigned long i, words;
+
+	if (++job.slot == job.slots)
+		job.slot = 0;
+	if (job_chase) {
+		/* Dependent loads in random order: word 0 holds the next offset */
+		for (i = 0; i < job.lines; i++) {
+			p = (uint64_t *)(base + off);
+			off = p[0];
+			sum += off + p[1] + p[2] + p[3] + p[4] + p[5] + p[6] + p[7];
+		}
+	} else {
+		for (i = 0; i < job.lines; i++) {
+			p = (uint64_t *)(base + i * JOB_LINE);
+			sum += p[0] + p[1] + p[2] + p[3] + p[4] + p[5] + p[6] + p[7];
+		}
+	}
+	w = (uint64_t *)(base + job.lines * JOB_LINE);
+	words = (job.slot_size - job.lines * JOB_LINE) / sizeof(*w);
+	for (i = 0; i < words; i++)
+		w[i] = sum + i;
+	job.sink = sum;
+}
+
+static void job_hist_sample(struct job_hist *h, int64_t ns)
+{
+	unsigned long bucket = ns > 0 ? ns / job_hist_ns : 0;
+
+	if (bucket < h->num)
+		h->buckets[bucket]++;
+	else
+		h->overflow++;
+	if (ns < h->min)
+		h->min = ns;
+	if (ns > h->max)
+		h->max = ns;
+	h->sum += ns;
+}
+
+static void job_record(int64_t latency, int64_t exec, int64_t resp)
+{
+	job_hist_sample(&job.exec, exec);
+	job_hist_sample(&job.resp, resp);
+	if (job.trace && 2 * job.cycles + 1 < job.trace_len) {
+		job.trace[2 * job.cycles] = latency > UINT32_MAX ? UINT32_MAX : latency;
+		job.trace[2 * job.cycles + 1] = exec > UINT32_MAX ? UINT32_MAX : exec;
+	}
+	job.cycles++;
+}
